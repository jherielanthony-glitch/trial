<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <meta name="description" content="PresyoCheck - Community price information for basic commodities and fuel.">
    <meta name="author" content="PresyoCheck">

    <title>PresyoCheck | Community Price Monitor</title>

    <style>
        :root {
            --green: #176b4d;
            --dark-green: #0f4935;
            --light-green: #eaf5f0;
            --red: #b84a42;
            --gray: #66706c;
            --light-gray: #f5f7f6;
            --border: #e0e5e2;
            --white: #ffffff;
            --black: #1e2522;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: var(--light-gray);
            color: var(--black);
            line-height: 1.6;
        }

        /* NAVIGATION */

        header {
            background: var(--white);
            border-bottom: 1px solid var(--border);
        }

        .nav {
            max-width: 1100px;
            margin: auto;
            padding: 18px 24px;

            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            font-size: 24px;
            font-weight: 800;
            color: var(--green);
            text-decoration: none;
        }

        .logo span {
            color: var(--black);
        }

        .nav-label {
            font-size: 13px;
            color: var(--gray);
        }

        /* HERO */

        .hero {
            max-width: 1100px;
            margin: 55px auto 30px;
            padding: 0 24px;
        }

        .eyebrow {
            color: var(--green);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            margin-bottom: 10px;
        }

        .hero h1 {
            max-width: 780px;
            font-size: clamp(36px, 6vw, 58px);
            line-height: 1.05;
            letter-spacing: -2px;
            margin-bottom: 18px;
        }

        .hero p {
            max-width: 650px;
            color: var(--gray);
            font-size: 16px;
        }

        /* UPDATE */

        .update-wrapper {
            max-width: 1100px;
            margin: 0 auto 35px;
            padding: 0 24px;
        }

        .update {
            background: var(--light-green);
            border: 1px solid #cfe5da;
            border-radius: 8px;
            padding: 14px 18px;

            font-size: 13px;
            color: #315b4a;
        }

        /* MAIN */

        main {
            max-width: 1100px;
            margin: auto;
            padding: 0 24px 70px;
        }

        .section-header {
            display: flex;
            justify-content: space-between;
            align-items: end;

            margin: 38px 0 16px;
        }

        .section-header h2 {
            font-size: 24px;
            line-height: 1.2;
        }

        .section-header p {
            color: var(--gray);
            font-size: 13px;
            margin-top: 4px;
        }

        /* PRICE GRID */

        .price-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
        }

        .price-card {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 19px;

            transition: transform .2s ease, box-shadow .2s ease;
        }

        .price-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, .05);
        }

        .category {
            color: #818986;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: .5px;
            margin-bottom: 5px;
        }

        .product {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 14px;
        }

        .price {
            font-size: 25px;
            font-weight: 800;
        }

        .unit {
            font-size: 11px;
            color: #858d89;
            font-weight: normal;
        }

        .change {
            font-size: 12px;
            font-weight: 700;
            margin-top: 7px;
        }

        .increase {
            color: var(--red);
        }

        .decrease {
            color: var(--green);
        }

        .unchanged {
            color: #747b78;
        }

        /* ARTICLE SECTION */

        .article-grid {
            display: grid;
            grid-template-columns: 1.5fr 1fr;
            gap: 14px;
        }

        .article {
            background: var(--white);
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 25px;
        }

        .article-label {
            color: var(--green);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
            margin-bottom: 9px;
        }

        .article h3 {
            font-size: 21px;
            line-height: 1.3;
            margin-bottom: 10px;
        }

        .article p {
            color: var(--gray);
            font-size: 14px;
            margin-bottom: 18px;
        }

        .article a {
            color: var(--green);
            text-decoration: none;
            font-size: 13px;
            font-weight: 700;
        }

        .article a:hover {
            text-decoration: underline;
        }

        /* INFORMATION */

        .information {
            margin-top: 35px;
            padding: 27px;

            background: var(--black);
            color: white;

            border-radius: 10px;
        }

        .information h2 {
            font-size: 21px;
            margin-bottom: 8px;
        }

        .information p {
            max-width: 800px;
            color: #cbd2cf;
            font-size: 13px;
        }

        /* SOURCES */

        .sources {
            margin-top: 35px;
            background: white;
            border: 1px solid var(--border);
            border-radius: 10px;
            padding: 25px;
        }

        .sources h2 {
            font-size: 20px;
            margin-bottom: 10px;
        }

        .sources p {
            font-size: 13px;
            color: var(--gray);
        }

        .sources ul {
            margin: 12px 0 0 18px;
        }

        .sources li {
            font-size: 13px;
            color: var(--gray);
            margin-bottom: 5px;
        }

        /* FOOTER */

        footer {
            background: white;
            border-top: 1px solid var(--border);
            padding: 30px 20px;
            text-align: center;
        }

        footer strong {
            color: var(--green);
        }

        footer p {
            color: #7b827f;
            font-size: 12px;
            margin-top: 4px;
        }

        /* TABLET */

        @media (max-width: 850px) {

            .price-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .article-grid {
                grid-template-columns: 1fr;
            }
        }

        /* MOBILE */

        @media (max-width: 500px) {

            .nav {
                padding: 15px 18px;
            }

            .nav-label {
                display: none;
            }

            .hero {
                margin-top: 38px;
                padding: 0 18px;
            }

            .hero h1 {
                font-size: 38px;
            }

            .update-wrapper,
            main {
                padding-left: 18px;
                padding-right: 18px;
            }

            .price-grid {
                grid-template-columns: 1fr 1fr;
                gap: 8px;
            }

            .price-card {
                padding: 15px;
            }

            .price {
                font-size: 21px;
            }

            .section-header {
                display: block;
            }
        }
    </style>
</head>

<body>

<header>

    <nav class="nav">

        <a href="#" class="logo">
            Presyo<span>Check</span>
        </a>

        <div class="nav-label">
